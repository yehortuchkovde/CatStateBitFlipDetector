{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Theory, simulations and detector",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Dataset analysis only",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--skip-simulations"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
